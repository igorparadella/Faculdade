-- Consulta 1: Listar todos os clientes e seus dados cadastrais
SELECT * FROM cliente;

-- Consulta 2: Mostrar produtos disponíveis com suas categorias
SELECT 
    p.nome AS Produto,
    c.nome AS Categoria,
    p.preco AS Preço,
    p.estoque AS Estoque
FROM produto p
INNER JOIN categoria c ON p.categoria = c.ID_categoria;

-- Consulta 3: Detalhar pedidos com itens, clientes e valores
SELECT 
    ped.ID_pedido AS Pedido,
    cli.nome AS Cliente,
    prd.nome AS Produto,
    ip.quantidade AS Quantidade,
    ip.preco_unitario AS "Preço Unitário",
    (ip.quantidade * ip.preco_unitario) AS Subtotal,
    ped.valor_total AS "Total do Pedido",
    ped.status AS Status
FROM pedido ped
INNER JOIN cliente cli ON ped.ID_cliente = cli.ID_cliente
INNER JOIN item_pedido ip ON ped.ID_pedido = ip.ID_pedido
INNER JOIN produto prd ON ip.ID_produto = prd.ID_produto;

-- Consulta 4: Total de vendas por categoria
SELECT 
    c.nome AS Categoria,
    SUM(ip.quantidade * ip.preco_unitario) AS "Total Vendido"
FROM item_pedido ip
INNER JOIN produto p ON ip.ID_produto = p.ID_produto
INNER JOIN categoria c ON p.categoria = c.ID_categoria
GROUP BY c.nome;

-- Consulta 5: Funcionários envolvidos nos pedidos e suas funções
SELECT 
    fp.ID_pedido AS Pedido,
    f.nome AS Funcionário,
    f.cargo AS Cargo,
    fp.funcao_no_pedido AS "Função no Pedido"
FROM funcionario_pedido fp
INNER JOIN funcionario f ON fp.ID_funcionario = f.ID_funcionario;

-- Consulta 6: Atualizar estoque após vendas (exemplo prático)
UPDATE produto p
INNER JOIN (
    SELECT ID_produto, SUM(quantidade) AS total_vendido
    FROM item_pedido
    GROUP BY ID_produto
) ip ON p.ID_produto = ip.ID_produto
SET p.estoque = p.estoque - ip.total_vendido;

-- Mostrar estoque atualizado após a operação
SELECT nome, estoque FROM produto;









